{
  "name": "dsh-agent-vault",
  "version": "2.0.2",
  "description": "Per-agent memory, one shared knowledge base, and per-conversation agent roles for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "rooms.js",
    "rank.js",
    "graph.js",
    "recall.js",
    "access.js",
    "transcripts.js",
    "embed.js",
    "vectors.js",
    "zstd-frames.mjs",
    "journal.js",
    "time.js",
    "handoff.js",
    "archive.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "eval/*.mjs",
    "eval/results/*.txt",
    "scripts/*.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "memory",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pikasphere/dsh-agent-vault.git"
  },
  "homepage": "https://github.com/Pikasphere/dsh-agent-vault#readme",
  "bugs": {
    "url": "https://github.com/Pikasphere/dsh-agent-vault/issues"
  },
  "scripts": {
    "prepack": "node test-package.mjs",
    "test": "node test-store.mjs && node test-binding.mjs && node test-handoff.mjs && node test-migrate.mjs && node test-rooms.mjs && node test-journal.mjs && node test-time.mjs && node test-recall.mjs && node test-transcripts.mjs && node test-embed.mjs && node test-host.mjs && node test-package.mjs"
  },
  "license": "MIT",
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  }
}
