{
  "name": "dsh-agent-vault",
  "version": "1.3.1",
  "description": "Per-agent memory, one shared knowledge base, and per-conversation agent roles for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "rooms.js",
    "journal.js",
    "handoff.js",
    "archive.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "memory",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pikasphere/dsh-agent-vault.git"
  },
  "homepage": "https://github.com/Pikasphere/dsh-agent-vault#readme",
  "bugs": {
    "url": "https://github.com/Pikasphere/dsh-agent-vault/issues"
  },
  "scripts": {
    "prepack": "node test-package.mjs"
  },
  "license": "MIT"
}
